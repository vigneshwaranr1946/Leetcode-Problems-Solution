
class Solution {
    public int differenceOfSum(int[] nums) {
        int esum = 0;
        int dsum = 0;
        for (int i = 0; i < nums.length; i++) {
            esum += nums[i];
            int n = nums[i];
            while (n > 0) {
                int digit = n % 10;
                dsum += digit;
                n /= 10;
            }
        }
        return esum - dsum;
    }
}
