class Solution {
    public boolean checkDivisibility(int n) {
        int org=n;
        int sum=0;
        int a=String.valueOf(n).length();
        int product=1;
        for(int i=0;i<a;i++){
            int digit=n%10;
            sum=sum+digit;
            product=product*digit;
            n=n/10;
        }
        
        if(org%(sum+product)==0){
            return true;
        }
        return false;
        
    }
}
